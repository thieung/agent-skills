# Optional path overrides for recall scripts.
# Defaults work for standard Claude Code installs and align with the session-sync skill.

# Claude Code source paths (raw JSONL).
CLAUDE_HOME="$HOME/.claude"
CLAUDE_PROJECTS_DIR="$HOME/.claude/projects"

# Parent folder that holds Claude-Sessions/. Matches session-sync's `target_folder`.
# If unset, recall reads session-sync's config.json, then falls back to $VAULT_DIR, then ~/Documents.
CLAUDE_SESSIONS_TARGET_FOLDER=""

# Obsidian vault root. Used as target_folder fallback and for graph path normalization.
VAULT_DIR=""

# Explicit override for extract-sessions output (skips the resolution chain above).
# Default: {target_folder}/Claude-Sessions/_recall
RECALL_OUTPUT_DIR=""
